#network
PLO_NETWORK=ploutos_network

#nginx_server
NGINX_TAG=stable

#php_library
PHP_TAG=7-fpm

#build_version
PLO_VERSION=v2

#app_env
APP_NAME=ploutos_bo
APP_CONF=./config
APP_LOG=./log
APP_WEB=./web
APP_API=./api
APP_PORT=80

#NodeJS
NODE_ENV=production
NODE_ENVIRONMENT=PAGCOR
NODE_ENV_ENDPOINT=http://bo.12ploutos.com
